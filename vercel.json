{
  "redirects": [
    {
      "source": "/:lang(en|ru)/yazilar/:slug",
      "destination": "/:lang/articles/:slug",
      "permanent": true
    },
    {
      "source": "/yazilar/:slug",
      "destination": "/articles/:slug",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru)/:dir(p|articles)/:slug([^./]+)",
      "destination": "/:lang/:dir/:slug.html",
      "permanent": true
    },
    {
      "source": "/:dir(p|articles)/:slug([^./]+)",
      "destination": "/:dir/:slug.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-oIkSnxqjSG6FZ7FP2mHEzopncV3th+AvVewR0CMrQXk='; style-src 'self' 'sha256-4bQlCbW/b+2KTdAHoryHB/Ko+15BkijKsAqwzdQMsh8=' 'sha256-RcPHlk/dEyvwZn0lnDP/vHHQ19zfKgQkJdD+wMnpOK0=' 'sha256-j4P8WIoM82qKPFw6NpjzMAOL6hvDvG2NPzJEB6a6JZU='; font-src 'self'; img-src 'self' data:; connect-src 'self' https://saytyoxla.vercel.app https://formspree.io; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formspree.io; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://ayfar.dev"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
